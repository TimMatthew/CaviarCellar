# Copy to .env and fill in. Values marked (later) aren't needed until the
# payment/delivery phases — the server boots for Phase A/B with just the DB block.

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
BASE_URL=http://localhost:3000
WEB_DIR=../client

# ── Database (required now) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=caviar-cellar
DB_POOL_MAX=10

# ── Admin (required now) ──────────────────────────────────
# Long random string; used to guard admin write routes.
ADMIN_API_KEY=change-me-to-a-long-random-string

# ── Fondy (later) ─────────────────────────────────────────
FONDY_MERCHANT_ID=
FONDY_SECRET_KEY=
CHECKOUT_RETURN_URL=http://localhost:3000/ordering/ordering.html
# ============================================================================
# FONDY USD TEST CONVERSION
# Enable only with NODE_ENV=development or NODE_ENV=test. Production always uses
# the original UAH amount regardless of this switch.
FONDY_TEST_USD_ENABLED=false
FONDY_TEST_UAH_PER_USD=40
# ============================================================================

# ── Nova Poshta (later) ───────────────────────────────────
NP_API_KEY=
NP_SENDER_REF=
NP_CONTACT_SENDER_REF=
NP_SENDER_CITY_REF=
NP_SENDER_ADDRESS_REF=
NP_SENDER_PHONE=380XXXXXXXXX
NP_SERVICE_TYPE=WarehouseWarehouse
NP_CARGO_TYPE=Parcel
NP_DEFAULT_WEIGHT_KG=1

# ── Background jobs ───────────────────────────────────────
SCHEDULER_ENABLED=false
DELIVERY_POLL_CRON=*/10 * * * *
TRACKING_BATCH_SIZE=50
OUTBOX_CRON=*/1 * * * *
OUTBOX_BATCH_SIZE=25
OUTBOX_RETRY_SECONDS=60
OUTBOX_MAX_RETRY_SECONDS=86400

# ── SMTP (later) ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Caviar Cellar <noreply@example.com>
