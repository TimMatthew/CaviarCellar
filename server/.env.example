# Copy to .env and fill in. Values marked (later) aren't needed until the
# payment/delivery phases — the server boots for Phase A/B with just the DB block.

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
BASE_URL=http://localhost:3000
WEB_DIR=../client

# ── Database (required now) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=caviar-cellar
DB_POOL_MAX=10

# ── Admin (required now) ──────────────────────────────────
# Long random string; used to guard admin write routes.
ADMIN_API_KEY=change-me-to-a-long-random-string

# ── Fondy (later) ─────────────────────────────────────────
FONDY_MERCHANT_ID=
FONDY_SECRET_KEY=

# ── Nova Poshta (later) ───────────────────────────────────
NP_API_KEY=

# ── SMTP (later) ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Caviar Cellar <noreply@example.com>
